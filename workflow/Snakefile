rule test_gpu:
    output: "results/tests/gpu_{id}.txt"
    resources:
        slurm_extra="'--gres=gpu:h100:1'"
    conda: "chrombpnet_0_1_7"
    shell:
        """
        nvidia-smi -L > {output}
        which nvcc >> {output}
        env >> {output}
        """

rule test_tf:
    output: "results/tests/tf_{id}.txt"
    resources:
        slurm_extra="'--gres=gpu:h100:1'"
    conda: "chrombpnet_0_1_7"
    shell:
        """
        python -c "import tensorflow as tf; print(tf.config.list_physical_devices('GPU'))" &> {output}
        """
