rule contribs_bw_fold_pretrained:
    input:
        fa=config['genome']['file'],
        chrom_sizes=config['chrom_sizes']['file'],
        bed_pk="resources/peaks/{sample}/{sample}.no_blacklist.bed",
        h5_nobias="results/chrombpnet_nobias/pretrained_bias/{sample}/{fold_id}/models/{sample}_{fold_id}._chrombpnet_nobias.h5"
    output:
        bw="results/chrombpnet_nobias/pretrained_bias/{sample}/{fold_id}/shap/{sample}_{fold_id}.{score_type}_scores.bw",
        h5="results/chrombpnet_nobias/pretrained_bias/{sample}/{fold_id}/shap/{sample}_{fold_id}.{score_type}_scores.h5"
    params:
        outdir="results/chrombpnet_nobias/pretrained_bias/{sample}/{fold_id}/shap"
    wildcard_constraints:
        score_type="(counts|profile)"
    threads: 4
    resources:
        slurm_extra="'--gres=gpu:h100:1'"
    conda: "chrombpnet_0_1_7"
    shell:
        """
        rm -rf {params.outdir}
        mkdir -p {params.outdir}
        export OMP_NUM_THREADS={threads}
        export OPENBLAS_NUM_THREADS={threads}
        chrombpnet contribs_bw \\
            -m {input.h5_nobias} \\
            -g {input.fa} -c {input.chrom_sizes} \\
            -r {input.bed_pk} \\
            -op {params.outdir}/{wildcards.sample}_{wildcards.fold_id} \\
            -pc {wildcards.score_type}
        """

