rule modisco_motifs_fold_pretrained:
    input:
        shap="results/chrombpnet_nobias/pretrained_bias/{sample}/{fold_id}/shap/{sample}_{fold_id}.{score_type}_scores.npz",
        onehot="results/chrombpnet_nobias/pretrained_bias/{sample}/{fold_id}/shap/{sample}_{fold_id}.{score_type}_onehot.npz"
    output:
        h5="results/chrombpnet_nobias/pretrained_bias/{sample}/{fold_id}/modisco/{sample}_{fold_id}.{score_type}_scores.modisco.h5"
    params:
        num_seqlets=config['modisco']['num_seqlets'],
        window=config['modisco']['window']
    wildcard_constraints:
        score_type="(counts|profile)"
    threads: 32
    resources:
        mem_mb=64000
    conda: "modiscolite_2_2_1"
    shell:
        """
        modisco motifs \\
            -s {input.onehot} \\
            -a {input.shap} \\
            -n {params.num_seqlets} \\
            -w {params.window} \\
            -o {output.h5} \\
            -v
        """

rule modisco_motifs_mean_pretrained:
    input:
        shap="results/chrombpnet_nobias/pretrained_bias/{sample}/mean/shap/{sample}_mean.{score_type}_scores.npz",
        onehot="results/chrombpnet_nobias/pretrained_bias/{sample}/mean/shap/{sample}_mean.{score_type}_onehot.npz"
    output:
        h5="results/chrombpnet_nobias/pretrained_bias/{sample}/mean/modisco/{sample}_mean.{score_type}_scores.modisco.h5"
    params:
        num_seqlets=config['modisco']['num_seqlets'],
        window=config['modisco']['window']
    wildcard_constraints:
        score_type="(counts|profile)"
    threads: 32
    resources:
        mem_mb=64000
    conda: "modiscolite_2_2_1"
    shell:
        """
        modisco motifs \\
            -s {input.onehot} \\
            -a {input.shap} \\
            -n {params.num_seqlets} \\
            -w {params.window} \\
            -o {output.h5} \\
            -v
        """

