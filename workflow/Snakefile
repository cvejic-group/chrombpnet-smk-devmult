rule modisco_bed_mean_pretrained_sorted:
    input:
        bed="results/chrombpnet_nobias/pretrained_bias/{sample}/mean/modisco/{sample}_mean.{score_type}_scores.raw.bed.gz"
    output:
        bed="results/chrombpnet_nobias/pretrained_bias/{sample}/mean/modisco/{sample}_mean.{score_type}_scores.sorted.bed.gz",
        tbi="results/chrombpnet_nobias/pretrained_bias/{sample}/mean/modisco/{sample}_mean.{score_type}_scores.sorted.bed.gz.tbi"
    wildcard_constraints:
        score_type="(counts|profile)"
    threads: 4
    resources:
        mem_mb=4000
    conda: "modiscolite_2_2_1"
    shell:
        """
        bgzip -@ {threads} -cd {input.bed} |\\
            grep -vE '^(track name|$)' |\\
            sort -k1,1 -k2,2n -k3,3n |\\
            bgzip -@ {threads} -c > {output.bed}
        tabix {output.bed}
        """

rule modisco_bedpe_mean_pretrained_sorted:
    input:
        bedpe="results/chrombpnet_nobias/pretrained_bias/{sample}/mean/modisco/{sample}_mean.{score_type}_scores.raw.bedpe.gz"
    output:
        bedpe="results/chrombpnet_nobias/pretrained_bias/{sample}/mean/modisco/{sample}_mean.{score_type}_scores.sorted.bedpe.gz"
    wildcard_constraints:
        score_type="(counts|profile)"
    threads: 4
    resources:
        mem_mb=4000
    conda: "modiscolite_2_2_1"
    shell:
        """
        bgzip -@ {threads} -cd {input.bedpe} |\\
            grep -vE '^(track name|$)' |\\
            sort -k1,1 -k2,2n -k3,3n -k5,5n -k6,6n |\\
            bgzip -@ {threads} -c > {output.bedpe}
        """

