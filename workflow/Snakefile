rule finemo_extract_regions_mean:
    input:
        h5="results/chrombpnet_nobias/pretrained_bias/{sample}/mean/shap/{sample}_mean.{score_type}_scores.h5"
    output:
        npz="results/chrombpnet_nobias/pretrained_bias/{sample}/mean/finemo/{sample}_mean.{score_type}_scores.npz"
    wildcard_constraints:
        score_type="(counts|profile)"
    threads: 32
    resources:
        slurm_extra="'--gres=gpu:h100:1'"
    conda: "finemo_0_25"
    shell:
        """
        finemo extract-regions-chrombpnet-h5 \\
            -c {input.h5} \\
            -o {output.npz}
        """

rule finemo_call_hits_mean:
    input:
        npz="results/chrombpnet_nobias/pretrained_bias/{sample}/mean/finemo/{sample}_mean.{score_type}_scores.npz",
        h5="results/chrombpnet_nobias/pretrained_bias/{sample}/mean/modisco/{sample}_mean.{score_type}_scores.modisco.h5",
        bed_pk="resources/peaks/{sample}/{sample}.no_blacklist.bed"
    output:
        bed_hits="results/chrombpnet_nobias/pretrained_bias/{sample}/mean/finemo/{score_type}_scores/hits.bed",
        tsv_hits="results/chrombpnet_nobias/pretrained_bias/{sample}/mean/finemo/{score_type}_scores/hits.tsv",
        tsv_hits_uniq="results/chrombpnet_nobias/pretrained_bias/{sample}/mean/finemo/{score_type}_scores/hits_unique.tsv",
        tsv_qc="results/chrombpnet_nobias/pretrained_bias/{sample}/mean/finemo/{score_type}_scores/peaks_qc.tsv",
        json="results/chrombpnet_nobias/pretrained_bias/{sample}/mean/finemo/{score_type}_scores/parameters.json"
    params:
        outdir="results/chrombpnet_nobias/pretrained_bias/{sample}/mean/finemo/{score_type}_scores",
        threshold=config['finemo']['cwm_trim_threshold'],
        alpha=config['finemo']['alpha'],
        batch=config['finemo']['batch_size'],
        args=config['finemo']['extra_args']
    wildcard_constraints:
        score_type="(counts|profile)"
    threads: 32
    resources:
        slurm_extra="'--gres=gpu:h100:1'"
    conda: "finemo_0_25"
    shell:
        """
        finemo call-hits \\
            -r {input.npz} \\
            -m {input.h5} \\
            -p {input.bed_pk} \\
            -o {params.outdir} \\
            -t {params.threshold} \\
            -a {params.alpha} \\
            -b {params.batch} \\
            {params.args}
        """

rule finemo_report_mean:
    input:
        npz="results/chrombpnet_nobias/pretrained_bias/{sample}/mean/finemo/{sample}_mean.{score_type}_scores.npz",
        tsv_hits="results/chrombpnet_nobias/pretrained_bias/{sample}/mean/finemo/{score_type}_scores/hits.tsv",
        h5="results/chrombpnet_nobias/pretrained_bias/{sample}/mean/modisco/{sample}_mean.{score_type}_scores.modisco.h5",
        bed_pk="resources/peaks/{sample}/{sample}.no_blacklist.bed"
    output:
        html="results/chrombpnet_nobias/pretrained_bias/{sample}/mean/finemo/{score_type}_scores/report.html"
    params:
        outdir="results/chrombpnet_nobias/pretrained_bias/{sample}/mean/finemo/{score_type}_scores",
        threshold=config['finemo']['cwm_trim_threshold'],
        width=config['modisco']['window']
    wildcard_constraints:
        score_type="(counts|profile)"
    threads: 16
    conda: "finemo_0_25"
    shell:
        """
        finemo report \\
            -r {input.npz} \\
            -H {input.tsv_hits} \\
            -m {input.h5} \\
            -p {input.bed_pk} \\
            -o {params.outdir} \\
            -W {params.width} \\
            -t {params.threshold}
        """

rule finemo_report_to_pdf:
    input:
        html="results/chrombpnet_nobias/pretrained_bias/{sample}/mean/finemo/{score_type}_scores/report.html"
    output:
        pdf="results/chrombpnet_nobias/pretrained_bias/{sample}/mean/finemo/{score_type}_scores/{sample}_mean.{score_type}_scores.report.pdf"
    params:
        width=640,
        height=1280
    wildcard_constraints:
        score_type="(counts|profile)"
    threads: 1
    conda: "chrombpnet_0_1_7"
    script: "scripts/finemo_html_to_pdf.py"

