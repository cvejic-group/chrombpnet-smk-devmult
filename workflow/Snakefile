    params:
        chrom="*"
    wildcard_constraints:
        score_type="(counts|profile)"
    threads: 1
    resources:
        mem_mb=24000
    conda: "modiscolite_2_2_1"
    shell:
        """
        modisco seqlet-bed \\
            -i {input.h5} \\
            -p {input.bed_pk} \\
            -c '{params.chrom}' |\\
            bgzip -c > {output.bed}
        """

