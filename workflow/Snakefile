rule modisco_bed_fold_pretrained:
    input:
        bed_pk="resources/peaks/{sample}/{sample}.no_blacklist.bed",
        h5="results/chrombpnet_nobias/pretrained_bias/{sample}/{fold_id}/modisco/{sample}_{fold_id}.{score_type}_scores.modisco.h5"
    output:
        bed="results/chrombpnet_nobias/pretrained_bias/{sample}/{fold_id}/modisco/{sample}_{fold_id}.{score_type}_scores.bed.gz",
        tbi="results/chrombpnet_nobias/pretrained_bias/{sample}/{fold_id}/modisco/{sample}_{fold_id}.{score_type}_scores.bed.gz.tbi"
    params:
        chrom="*"
    wildcard_constraints:
        score_type="(counts|profile)"
    threads: 1
    resources:
        mem_mb=24000
    conda: "modiscolite_2_2_1"
    shell:
        """
        modisco seqlet-bed \\
            -i {input.h5} \\
            -p {input.bed_pk} \\
            -c '{params.chrom}' |\\
            grep -vE '^(track name|$)' |\\
            sort -k1,1 -k2,2n -k3,3n |\\
            bgzip -c > {output.bed}
        tabix {output.bed}
        """

