configfile: "config/config.yaml"

import os
from sys import stderr

# print to stderr
def message(*args, **kwargs):
    print(*args, file=stderr, **kwargs)

# ensure tmp directory exists
os.makedirs(config['tmp_dir'], exist_ok=True)

# load sample data
message("[INFO] Checking sample info...")
samples = config['samples']
message(f"[INFO]   Found {len(samples.keys())} samples.")

# load BED peak info
message("[INFO] Checking peaks info...")
peak_beds = config['peak_bed']
message(f"[INFO]   Found {len(peak_beds.keys())} peak files.")

# match samples
matched_sample_ids = samples.keys() & peak_beds.keys()
message(f"[INFO]   Found {len(matched_sample_ids)} samples with matched peaks.")

# match sample targets
sce2g_bedpes = config['peak_gene_link']['scE2G']
samples_sce2g = samples.keys() & sce2g_bedpes.keys()
message(f"[INFO]   Found {len(samples_sce2g)} samples with matched scE2G links.")

wildcard_constraints:
    sample="[^/.]+",
    bam_id="[^/]+",
    fold_id="fold_[0-9]+"

